# PostgreSQL must use SQLAlchemy's asyncpg driver.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/railro
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
APP_DEBUG=false

# Async Redis connection used by the E-Way Bill cache.
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins. Add the frontend origin when it runs elsewhere.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

LOG_LEVEL=INFO
